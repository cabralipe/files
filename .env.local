# ===== NVIDIA NIM (IA - Geração de Planos) =====
# Cascata de modelos: 1º Gemma-2-2b -> 2º GLM-5.1 -> 3º Nemotron -> template estático local

# 1º Primário (Gemma 2 2B)
NVIDIA_API_KEY=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
NVIDIA_MODEL=google/gemma-2-2b-it

# 2º Fallback (GLM-5.1)
NVIDIA_API_KEY_FALLBACK=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
NVIDIA_MODEL_FALLBACK=z-ai/glm-5.1

# 3º Fallback experimental (Nemotron)
NVIDIA_API_KEY_FALLBACK_2=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
NVIDIA_MODEL_FALLBACK_2=nvidia/nemotron-3-super-120b-a12b

# Timeouts e limites para evitar planos longos demais
NVIDIA_PRIMARY_TIMEOUT_MS=12000
NVIDIA_FALLBACK_TIMEOUT_MS=25000
NVIDIA_FALLBACK_2_TIMEOUT_MS=45000
NVIDIA_MAX_TOKENS=1800
NVIDIA_REASONING_BUDGET=512
NVIDIA_ENABLE_THINKING=false
NVIDIA_FALLBACK_ENABLE_THINKING=false

# ===== AUTENTICAÇÃO =====
# Sessão de usuário (segundos)
NEXT_PUBLIC_SESSION_TIMEOUT=3600

# ===== ARMAZENAMENTO =====
# Buckets Supabase Storage
NEXT_PUBLIC_AVATARS_BUCKET=avatars
NEXT_PUBLIC_EXPERIENCE_IMAGES_BUCKET=experience-images
NEXT_PUBLIC_PLAN_ATTACHMENTS_BUCKET=plan-attachments
NEXT_PUBLIC_BACKUPS_BUCKET=backups

