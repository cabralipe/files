# ============================================
# SUPABASE
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
# Chave pública (publishable / anon) do projeto Supabase
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=seu-publishable-key-aqui
# Chave service role (NUNCA expor no client — só usada no servidor)
SUPABASE_SERVICE_ROLE_KEY=seu-service-role-key-aqui
# Conexão direta Postgres (usada pelo pg)
DATABASE_URL=postgresql://usuario:senha@host:5432/postgres

# ============================================
# OpenAI API (geração de planos e PEI)
# ============================================
OPENAI_API_KEY=sua-chave-openai-aqui
OPENAI_MODEL=gpt-5-nano
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_OUTPUT_TOKENS=4200
OPENAI_REASONING_EFFORT=minimal

# ============================================
# VERCEL BLOB (upload de imagens)
# ============================================
BLOB_READ_WRITE_TOKEN=seu-token-vercel-blob-aqui

# ============================================
# GERAÇÃO DE PLANOS POR IA
# ============================================
# Por padrão, gerar plano exige LOGIN (contém custo de IA).
# Defina como "true" para reabrir a geração pública (sem login) — nesse caso
# vale o rate limit por IP. Rotas afetadas: /api/plans/generate e
# /api/bncc-nacional/generate.
ALLOW_PUBLIC_PLAN_GENERATION=false

# ============================================
# ADMIN / ACESSO
# ============================================
# Emails com acesso administrativo elevado
ADMIN_EMAIL=admin@seu-dominio.com
SUPER_ADMIN_EMAIL=superadmin@seu-dominio.com
NEXT_PUBLIC_SUPER_ADMIN_EMAIL=superadmin@seu-dominio.com

# ============================================
# APP
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Opcional: atalho /admin para um municipio especifico. A raiz / abre /bncc-nacional.
NEXT_PUBLIC_DEFAULT_MUNICIPALITY_SLUG=

# ============================================
# INTEGRAÇÃO COM O SAM (somente servidor)
# ============================================
SAM_BASE_URL=http://localhost:3001
# Mesmo segredo configurado como BNCC_INTEGRATION_SECRET no SAM.
SAM_INTEGRATION_SECRET=gere-um-segredo-aleatorio-com-pelo-menos-32-caracteres
