# ============================================================
#  SUPABASE
#  Acesse: https://supabase.com/dashboard → seu projeto → Settings → API
# ============================================================

# URL do projeto (Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave pública / publishable key (anon key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sua-anon-key-aqui

# Chave de serviço — NUNCA exponha no frontend (service_role key)
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# ============================================================
#  SUPER ADMIN
#  Define quem tem acesso à aba "Municípios" e às rotas
#  /super-admin e /api/super-admin/*
#  Alternativa ao SQL: basta colocar o e-mail aqui.
# ============================================================
NEXT_PUBLIC_SUPER_ADMIN_EMAIL=admin@seusite.com
SUPER_ADMIN_EMAIL=admin@seusite.com

# E-mail de admin geral (acesso às rotas /api/admin/*)
ADMIN_EMAIL=admin@seusite.com

# ============================================================
#  MUNICÍPIOS
#  Slug padrão usado quando nenhum município está na URL.
#  Exemplo: se o seu município principal é "atalaia-al", use esse valor.
# ============================================================
NEXT_PUBLIC_DEFAULT_MUNICIPALITY_SLUG=atalaia-al

# ============================================================
#  APP
# ============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================
#  OPENAI (geração de planos de aula com IA)
#  Acesse: https://platform.openai.com/api-keys
# ============================================================
OPENAI_API_KEY=sua-chave-openai-aqui
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_OUTPUT_TOKENS=4200
OPENAI_REASONING_EFFORT=minimal

# ============================================================
#  VERCEL BLOB (upload de imagens)
#  Acesse: Vercel Dashboard → Storage → Blob
# ============================================================
BLOB_READ_WRITE_TOKEN=seu-token-vercel-blob-aqui
