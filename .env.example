# ============================================
# SUPABASE
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
# Chave pública (publishable / anon) do projeto Supabase
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=seu-publishable-key-aqui
# Chave service role (NUNCA expor no client — só usada no servidor)
SUPABASE_SERVICE_ROLE_KEY=seu-service-role-key-aqui
# Conexão direta Postgres (usada pelo pg)
DATABASE_URL=postgresql://usuario:senha@host:5432/postgres

# ============================================
# OpenAI API (geração de planos e PEI)
# ============================================
OPENAI_API_KEY=sua-chave-openai-aqui
OPENAI_MODEL=gpt-5-nano
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_OUTPUT_TOKENS=4200
OPENAI_REASONING_EFFORT=minimal

# ============================================
# VERCEL BLOB (upload de imagens)
# ============================================
BLOB_READ_WRITE_TOKEN=seu-token-vercel-blob-aqui

# ============================================
# ADMIN / ACESSO
# ============================================
# Emails com acesso administrativo elevado
ADMIN_EMAIL=admin@seu-dominio.com
SUPER_ADMIN_EMAIL=superadmin@seu-dominio.com
NEXT_PUBLIC_SUPER_ADMIN_EMAIL=superadmin@seu-dominio.com

# ============================================
# APP
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Slug do município padrão (rotas vivem sob /[municipio])
NEXT_PUBLIC_DEFAULT_MUNICIPALITY_SLUG=atalaia
